NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BUSINESS_NAME=Sunrise Dental Clinic

SUPABASE_SERVICE_ROLE_KEY=
WA_MOCK_SHARED_SECRET=dev-secret-change-me

# Internal shared secret for calling backend from admin (e.g. reply to customer).
# Must match INTERNAL_SHARED_SECRET in apps/backend/.env
INTERNAL_SHARED_SECRET=

# 3.2 — tier enforcement mode. MUST be kept in lockstep with the backend's
# Railway env (the two apps gate the same features; a mismatch means the
# admin renders UI the backend 402s, or vice versa). UNSET is NOT soft —
# unset falls through to per-feature FEATURE_BLOCK_MODE (de-facto MIXED,
# 11 compliance features hard-402). Pin explicitly: soft | mixed | hard.
TIER_ENFORCEMENT_MODE=soft
